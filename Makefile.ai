# Lab 6. parse-test is offline. Live Gemini calls need approval; use the hidden-input helper.
AI_STACK := $(PROJECT)-ai
AI_URL = $(call stack_output,$(AI_STACK),ParserUrl)
AI_SCRIPT_ENV = PROJECT=$(PROJECT) BACKEND_FUNCTION=$(BACKEND_FUNCTION) AI_LAMBDA_ARCH=$(LAMBDA_ARCH) \
 PARSER_MODEL="$(or $(PARSER_MODEL),gemini-3.5-flash-lite)" \
 PARSER_PROMPT_VERSION="$(or $(PARSER_PROMPT_VERSION),agenda-v2-gemini)" PARSER_BILLING_TIER="$(or $(PARSER_BILLING_TIER),free)" \
 GEMINI_API_KEY_SECRET_ARN="$(GEMINI_API_KEY_SECRET_ARN)" \
 PARSER_CONCURRENCY="$(or $(PARSER_CONCURRENCY),0)" EXISTING_BUDGET_NAME="$(or $(EXISTING_BUDGET_NAME),meetings-monthly-5usd)"

.PHONY: llm-hello parse parse-test ai-deploy ai-config ai-url ai-logs
llm-hello: ## Hidden-key prompt; one Gemini test only after explicit terminal confirmation
	cd backend && PYTHONPATH=. uv run python scripts/llm_hello.py

parse: ## Live Gemini parse via configured Secrets Manager ARN (approval required)
	@test -n "$(TEXT)" || { echo 'Set TEXT to the agenda'; exit 1; }
	cd backend && PYTHONPATH=. uv run python scripts/parse.py "$$TEXT"

parse-test: ## Offline parser and handler tests (no AWS)
	cd backend && uv run pytest tests/test_agenda.py tests/test_agenda_lambda.py -q

ai-deploy: aws-check aws-backend-push ## Build/push and preview parser change set (AWS writes; approval required)
	$(AI_SCRIPT_ENV) AI_IMAGE_URI=$(ECR_URI):$(TAG) bash infra/scripts/ai-deploy.sh

ai-config: aws-check ## Preview parser configuration with explicit TAG/image (requires approval)
	$(AI_SCRIPT_ENV) AI_IMAGE_URI=$(ECR_URI):$(TAG) bash infra/scripts/ai-deploy.sh

ai-url: ## Print parser Function URL
	@echo "$(AI_URL)"

ai-logs: ## Read recent parser log messages
	$(AWS_SHELL) logs tail /aws/lambda/$(PROJECT)-agenda-parser --since 15m
