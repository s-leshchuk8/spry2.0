# Backend image for AWS Lambda (the Dockerfile next to it is for Docker Compose).
FROM public.ecr.aws/lambda/python:3.12

COPY --from=ghcr.io/astral-sh/uv:latest /uv /bin/uv

COPY pyproject.toml ${LAMBDA_TASK_ROOT}/
RUN uv pip install --no-cache --target "${LAMBDA_TASK_ROOT}" -r pyproject.toml

COPY alembic.ini ${LAMBDA_TASK_ROOT}/
COPY alembic ${LAMBDA_TASK_ROOT}/alembic
COPY app ${LAMBDA_TASK_ROOT}/app

CMD ["app.lambda_handler.handler"]
