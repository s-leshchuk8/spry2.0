POSTGRES_USER=meetings
POSTGRES_PASSWORD=meetings
POSTGRES_DB=meetings
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
SEED=true
# Host ports (change if already taken on your machine)
DB_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=3000
# Cognito: `make aws-cognito-deploy` (or `make aws-cognito-env`) prints these values. Empty = auth disabled locally: no sign-in is
# checked and every request acts as one local user.
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_DOMAIN=
COGNITO_GOOGLE_ENABLED=false
# Google sign-in: create an OAuth client in Google Cloud (redirect URI
# https://<COGNITO_DOMAIN>/oauth2/idpresponse), set both, then `make aws-cognito-deploy` and redeploy.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# AWS deployment (`make aws-deploy`, always to us-east-1). .env is gitignored — never commit real keys.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# CloudFront pricing: FREE (flat-rate Free plan, max 3 per account) or PAY_AS_YOU_GO
CLOUDFRONT_PLAN=FREE
PARSER_MODEL=gemini-3.5-flash-lite
PARSER_REGION=us-east-1
PARSER_PROMPT_VERSION=agenda-v2-gemini
# Non-secret ARN only. Enter the API key with backend/scripts/gemini_key.py, never in .env.
GEMINI_API_KEY_SECRET_ARN=
PARSER_BILLING_TIER=free
VITE_AGENDA_PARSER_URL=
# Existing budget recipient, for verification only; the parser stack does not change it.
BUDGET_EMAIL=solosun0308@gmail.com
# Local-only labelled mock; still requires authentication. Cloud template always sets 0.
PARSER_MOCK=0
# 0 omits reserved concurrency for the current 10-concurrency account quota.
PARSER_CONCURRENCY=0
EXISTING_BUDGET_NAME=meetings-monthly-5usd
